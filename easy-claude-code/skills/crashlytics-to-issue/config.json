{
  "last_updated_at": null,
  "firebase": {
    "project_id": null,
    "apps": []
  },
  "github": {
    "repo": null,
    "default_labels": ["source:crashlytics"]
  },
  "query": {
    "lookback_days": 3,
    "page_size": 50,
    "report": "TOP_ISSUES"
  },
  "severity_thresholds": {
    "blocker": {
      "impacted_users_min": 1000,
      "event_count_min": 10000,
      "error_types": ["FATAL"]
    },
    "critical": {
      "impacted_users_min": 100,
      "event_count_min": 1000,
      "error_types": ["FATAL", "ANR"]
    },
    "major": {}
  },
  "regression": {
    "auto_close": true
  },
  "module": {
    "language": "ko"
  },
  "issue_body": {
    "include_breadcrumbs": true,
    "include_custom_keys": true,
    "include_logs": true,
    "include_variants": true,
    "max_top_devices": 5,
    "max_top_os_versions": 5,
    "max_top_app_versions": 5,
    "max_top_regions": 5,
    "max_top_variants": 5,
    "max_breadcrumbs": 50,
    "max_logs": 50
  },
  "concurrency": {
    "max_parallel_apps": 5
  },
  "retry": {
    "max_attempts": 3,
    "backoff_seconds": [2, 5, 10]
  }
}
